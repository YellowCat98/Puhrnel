// written in jsonc because i couldnt be bothered with writing full fledged docs
// this might have a few syntax errors because it prioritizes docs over actual jsonc syntax
{
    "syscalls/interrupts": {
        "syscall convention": {
            "eax": "which syscall kind (PUHLOG, etc.)",
            "ebx": "which syscall",
            "ecx": "arg 1",
            "edx": "arg 2",
            "esi": "arg 3",
            "edi": "arg 4",
            "ebp": "arg 5"
        },
        "return values": "If a function needs to return a value, it will be placed into EAX.",

        // Format used: "x, n" x is the syscall kind/syscall name, while n is its identifier used in Assembly.
        // can be used by both userspace and kernel
        "0x80": {
            "contents": {
                "PUHLOG, 0": {
                    "description": "Printing utilities.",
                    "PUHLOG_PRINT, 0": {
                        "description": "Simply prints to the screen.",
                        "arg 1": "Pointer to the message itself",
                        "arg 2": "Color" // TODO: DOCUMENT vga_color
                    },
                    "PUHLOG_CLEAR": "Clears the screen."
                },
                "PUHINFO, 1": {
                    "description": "Kernel information.",

                    "PUHLOG_CODENAME, 0": "Returns the kernel codename.",
                    "PUHLOG_VERSION, 1": "Returns the kernel version.",
                    "PUHLOG_FULLNAME, 2": "Full kernel name in the form of puhrnel_$(codename)_v$(version)",
                    "PUHLOG_PRETTYCODENAME, 3": "Prettified version of the codename.",
                    "PUHLOG_PRETTYFULLNAME, 4": "Prettified version of the full name."
                }
            }
        }
        /*
        example:
            mov eax, 0 ; PUHLOG
            mov ebx, 0 ; PRINT
            mov ecx, pointer_to_message ; arg 1
            int 0x80

        example 2:
            mov eax, 0 ; PUHLOG
            mov ebx, 1 ; CLEAR
            int 0x80
        */
    }
}